# Nakon ovoga, kopiraj "token" iz response-a i zameni @token varijablu na vrhu fajla
POST {{baseUrl}}/api/auth
Content-Type: application/json

{
  "username": "newuser",
  "password": "password123"
}

### 3. Test invalid login
POST {{baseUrl}}/api/auth
Content-Type: application/json

{
  "username": "wronguser",
  "password": "wrongpass"
}

